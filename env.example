# =============================================================================
# My Financial Life — Environment Variables
# =============================================================================
# Copy this file to backend/.env and frontend/.env, then fill in values.
# =============================================================================

# ----------------------------------------
# BACKEND — copy to backend/.env
# ----------------------------------------

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/myfinanciallife

# Security — generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your-secret-key-here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS — comma-separated origins allowed to make requests
ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:5173"]
ALLOWED_HOSTS=["*"]

# Debug
DEBUG=true

# PostgreSQL (used by Docker Compose)
POSTGRES_DB=myfinanciallife
POSTGRES_USER=myfinanciallife_user
POSTGRES_PASSWORD=myfinanciallife_password

# ----------------------------------------
# FRONTEND — copy to frontend/.env
# ----------------------------------------

VITE_API_URL=
VITE_APP_NAME=My Financial Life
