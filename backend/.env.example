# Database
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Security
SECRET_KEY=change-me-to-a-random-secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS
ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:5173"]
ALLOWED_HOSTS=["*"]

# Dev
DEBUG=true

# AI — Gemini is the ONLY cloud provider (free tier). Optional: the app works fully
# without it (rules-based parsing). Off by default per-user even when set here — see
# rules/database.md AI allocation table.
GEMINI_API_KEY=

# PostgreSQL (used by Docker Compose)
POSTGRES_DB=myfinanciallife
POSTGRES_USER=user
POSTGRES_PASSWORD=password
